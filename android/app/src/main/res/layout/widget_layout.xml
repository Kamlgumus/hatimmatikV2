<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center"
    android:background="#0B3D2E" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🕌 Hatimmatik" android:textColor="#FFFFFF" android:textSize="14sp"/>
    <TextView android:id="@+id/widget_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0" android:textColor="#C9A227" android:textSize="42sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="gün seri 🔥" android:textColor="#FFFFFF" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_page" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Sayfa: 1" android:textColor="#C9A227" android:textSize="13sp" android:paddingTop="4dp"/>
</LinearLayout>